# Local Compose configuration
POSTGRES_DB=car_db
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas
DATABASE_URL=postgresql://saas:saas@db:5432/car_db

# Backend application configuration
JWT_SECRET_KEY=change-me-in-local-development
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

CORS_ORIGINS=http://localhost:4200,http://localhost:5173
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
FRONTEND_URL=http://localhost:4200
UPLOAD_DIRECTORY=uploads

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYMENT_PROVIDER=mock

# Frontend build configuration
# VITE_* values are public and embedded into the static frontend image.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_GOOGLE_MAPS_API_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Frontend Nginx runtime configuration
BACKEND_URL=http://backend:5500
