```gitignore
# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# Virtual environments
.venv/
venv/
env/

# =========================
# uv
# =========================
# Keep uv.lock committed for applications.
# Uncomment the next line only if you intentionally don't want to version it.
# uv.lock

# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example

# =========================
# Logs
# =========================
logs/
*.log

# =========================
# Uploads & generated files
# =========================
uploads/
tmp/
*.sqlite3

# =========================
# IDEs
# =========================
.vscode/
.idea/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Build artifacts
# =========================
dist/
build/

# =========================
# Node (only if your repo contains a frontend)
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
```
