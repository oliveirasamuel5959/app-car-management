# Application settings (copy to .env and fill in). Every value below is a placeholder.

DATABASE_URL=postgresql://saas:saas@localhost:5432/car_db

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# JWT Settings
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Settings
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Stripe Settings (optional — leave unset to run the mock payment provider locally)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYMENT_PROVIDER=stripe
